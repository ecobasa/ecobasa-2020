{
    "name": "ecobasa",
    "version": "3.0.0",
    "description": "gift-economy network for sustainable communities",
    "author": "Arne Bollinger",
    "license": "none",
    "scripts": {
        "build:css": "postcss static_src/styles/base.css -o static/styles/base.min.css",
        "watch:css": "onchange -i '**/*.*' tailwind.config.js -e 'static/styles/base.min.css' -- npm run build:css",
        "build": "npm run build:css",
        "watch": "npm run watch:css"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.7",
        "autoprefixer": "^10.4.20",
        "cssnano": "^6.1.0",
        "onchange": "^7.1.0",
        "postcss": "^8.4.38",
        "postcss-cli": "^11.0.0",
        "postcss-import": "^15.1.0",
        "postcss-nested": "^6.0.1",
        "tailwindcss": "^3.4.10"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^5.15.3",
        "alpinejs": "^3.15.12",
        "typeface-bree-serif": "0.0.72",
        "typeface-lato": "^1.1.13"
    }
}
