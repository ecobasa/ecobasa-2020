DJANGO_SETTINGS_MODULE=settings.dev
DATABASE_URL=postgis://ecobasa:ecobasa@database/ecobasa
STADIA_MAPS_KEY=your-stadia-api-key-here


# Keeping events and tours current (archive_stale_events, archive_stale_tours); the
# values here are the defaults
EVENT_STALE_DAYS=60
EVENT_ARCHIVE_GRACE_DAYS=14
TOUR_ARCHIVE_AFTER_DAYS=7
TOUR_IDEA_STALE_DAYS=180
TOUR_IDEA_ARCHIVE_GRACE_DAYS=14

# The video server of online gift-circles, and whether it lets ecobasa embed its rooms
# (meet.ffmuc.net only once it lists ecobasa.org in its frame-ancestors)
JITSI_BASE_URL=https://meet.systemli.org
JITSI_EMBED=true
