msgstr "Dein Benutzername, falls du ihn vergessen hast:"

#: users/templates/users/password_reset/email.html:10
msgid "Thanks for using our site!"
msgstr "Danke, dass du ecobasa nutzt!"

#: users/templates/users/password_reset/email.html:12
#, python-format
msgid "The %(site_name)s team"
msgstr "Das %(site_name)s-Team"

