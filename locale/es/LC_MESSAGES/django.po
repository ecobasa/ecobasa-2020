msgstr "¿Retirar tu inscripción?"

#: gift_economy/gift_circles/templates/gift_circles/guest_sent.html:11
#, python-format
msgid "We sent an email to <strong>%(email)s</strong>. Open the link in it: only then do you count as coming."
msgstr "Hemos enviado un correo a <strong>%(email)s</strong>. Abre el enlace que contiene: solo entonces cuentas como asistente."

#: gift_economy/gift_circles/templates/gift_circles/guest_sign_up.html:11
