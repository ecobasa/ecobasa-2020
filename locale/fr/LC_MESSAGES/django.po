msgstr "%(actor)s a répondu à ta demande d'adhésion : %(title)s"

msgid "Start from a text"
msgstr "Commencer par un texte"

msgid "Saying no with care"
msgstr "Dire non avec soin"

msgid "Send and decline"
msgstr "Envoyer et refuser"

msgid "Replace what you wrote with this text?"
msgstr "Remplacer ce que tu as écrit par ce texte ?"

msgid "Communities looking for new members"
msgstr "Communautés qui cherchent de nouveaux membres"

msgid "Applied"
msgstr "Demandé"

msgid "Accepted before"
msgstr "Déjà accepté·e"

msgid "Declined before"
msgstr "Déjà refusé·e"

msgid "Applied before"
msgstr "Déjà demandé"

msgid "Outcome"
msgstr "Résultat"

msgid "Past application"
msgstr "Demande passée"

msgid "Past applications"
msgstr "Demandes passées"

