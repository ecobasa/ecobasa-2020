msgid ""
"Content written by members belongs to them. The name, the logo and the code "
"are not covered, <a class=\"text-yellow\" href=\"%(license_url)s\">see "
"details</a>."
msgstr "Ce que les membres écrivent leur appartient. Le nom, le logo et le code ne sont pas inclus, <a class=\"text-yellow\" href=\"%(license_url)s\">plus de détails</a>."

msgid "Your email"
msgstr "Ton e-mail"

msgid "Please leave links out of your name."
msgstr "Merci de ne pas mettre de liens dans ton nom."

msgid "Please leave links out of the subject."
msgstr "Merci de ne pas mettre de liens dans l'objet."

msgid "Please send at most two links."
msgstr "Merci d'envoyer au plus deux liens."

msgid "That didn't work. Please send it again."
msgstr "Ça n'a pas marché. Merci de le renvoyer."

msgid "You have sent us several messages already. Please try again tomorrow."
msgstr "Tu nous as déjà envoyé plusieurs messages. Merci de réessayer demain."

msgid "We have received this message already."
msgstr "Nous avons déjà reçu ce message."

msgid "Thank you! Your message is on its way to us."
msgstr "Merci ! Ton message est en route vers nous."

msgid "Your message could not be sent right now. Please try again later."
msgstr "Ton message n'a pas pu être envoyé pour le moment. Merci de réessayer plus tard."

msgid "Questions, ideas, or you want to help? We read every message and answer by email."
msgstr "Des questions, des idées, ou tu veux aider ? Nous lisons chaque message et répondons par e-mail."

#, python-format
msgid "We'll answer to %(email)s."
msgstr "Nous répondrons à %(email)s."

msgid "To keep bots out, this form needs JavaScript. Please turn it on."
msgstr "Pour éviter les robots, ce formulaire a besoin de JavaScript. Merci de l'activer."

msgid "Checking…"
msgstr "Vérification…"

msgid "Send message"
msgstr "Envoyer le message"

msgid "Too many tries from your connection. Please try again tomorrow."
msgstr "Trop de tentatives depuis ta connexion. Merci de réessayer demain."

msgid "Email address confirmed"
msgstr "Adresse e-mail confirmée"

msgid "Confirm your email address for ecobasa"
msgstr "Confirme ton adresse e-mail pour ecobasa"

msgid "Welcome to ecobasa! Please confirm that this is your address. Then you can share gifts and skills, write to people and visit communities."
msgstr "Bienvenue sur ecobasa ! Merci de confirmer que c'est bien ton adresse. Ensuite tu pourras partager des dons et des compétences, écrire aux gens et visiter des communautés."

msgid "The link works for 7 days. If you didn't sign up, you can ignore this email."
msgstr "Le lien fonctionne pendant 7 jours. Si tu ne t'es pas inscrit·e, tu peux ignorer cet e-mail."

#, python-format
msgid "Welcome! We sent a link to %(email)s. Please open it to confirm your address, then you can start sharing."
msgstr "Bienvenue ! Nous avons envoyé un lien à %(email)s. Ouvre-le pour confirmer ton adresse, ensuite tu pourras commencer à partager."

msgid "This link doesn't work any more. Log in to ask for a new one."
msgstr "Ce lien ne fonctionne plus. Connecte-toi pour en demander un nouveau."

msgid "Thank you, your email address is confirmed. Happy sharing!"
msgstr "Merci, ton adresse e-mail est confirmée. Bon partage !"

msgid "We sent you a link a few minutes ago. Please look in your spam folder too."
msgstr "Nous t'avons envoyé un lien il y a quelques minutes. Regarde aussi dans tes spams."

#, python-format
msgid "We sent a new link to %(email)s."
msgstr "Nous avons envoyé un nouveau lien à %(email)s."

#, python-format
msgid "Please confirm your email address first: open the link we sent to %(email)s."
msgstr "Merci de confirmer d'abord ton adresse e-mail : ouvre le lien envoyé à %(email)s."

#, python-format
msgid "Please confirm your email address: open the link we sent to <strong>%(email)s</strong>. Until then you can look around, but not share or write to people yet."
msgstr "Merci de confirmer ton adresse e-mail : ouvre le lien envoyé à <strong>%(email)s</strong>. D'ici là tu peux regarder, mais pas encore partager ni écrire aux gens."

msgid "Send the link again"
msgstr "Renvoyer le lien"

msgid "Show me on the pioneer map"
msgstr "M'afficher sur la carte des pionnier·ères"

msgid "only members see it, so they can invite you to gift-circles, tours and communities"
msgstr "seuls les membres la voient, pour pouvoir t'inviter à des cercles de dons, des tours et des communautés"

msgid "Open to tour suggestions"
msgstr "Ouvert aux suggestions de tours"

msgid "Pioneers"
msgstr "Pionnier·ères"

msgid "Name, skill or place…"
msgstr "Nom, compétence ou lieu…"

msgid "Skills they share"
msgstr "Compétences qu'ils partagent"

msgid "Show pioneers near me"
msgstr "Montrer les pionnier·ères près de moi"

msgid "No pioneers found."
msgstr "Aucun·e pionnier·ère trouvé·e."

msgid "Choose someone to invite: “Invite” in their card takes them back to your invitation."
msgstr "Choisis quelqu'un à inviter : « Inviter » sur sa fiche le ramène à ton invitation."

msgid "Back to the invitation"
msgstr "Retour à l'invitation"

msgid "You aren't on the map: add your place in your profile."
msgstr "Tu n'es pas sur la carte : ajoute ton lieu dans ton profil."

msgid "You aren't on the map: you chose not to show yourself."
msgstr "Tu n'es pas sur la carte : tu as choisi de ne pas t'afficher."

msgid "Invite"
msgstr "Inviter"

msgid "Find pioneers on the map"
msgstr "Trouver des pionnier·ères sur la carte"

msgid "%(count)s pioneer"
msgid_plural "%(count)s pioneers"
msgstr[0] "%(count)s pionnier·ère"
msgstr[1] "%(count)s pionnier·ères"

msgid "Looking for a community"
msgstr "Cherche une communauté"

msgid "shows on your profile, so communities can invite you to become a member"
msgstr "s'affiche sur ton profil, pour que les communautés puissent t'inviter à devenir membre"
