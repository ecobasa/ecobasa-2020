msgstr ""
"Fonder une nouvelle communauté avec les personnes et les ressources dont "
"vous avez besoin"

#: homepage/templates/homepage/homepage.html:58
msgid "Coming together"
msgstr "Se rassembler"

#: homepage/templates/homepage/homepage.html:61
msgid "Events: projects and open days to visit and help out at"
msgstr ""
"Événements : des projets et des journées portes ouvertes à visiter et où "
"donner un coup de main"

#: homepage/templates/homepage/homepage.html:62
